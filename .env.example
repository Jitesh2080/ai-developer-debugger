# ---- Server ----
PORT=4000
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://debugger:debugger@localhost:5433/debugger

# LLM provider: "openai" (default). Abstraction allows adding others later.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension must match the model AND is used to size the DB vector
# column at migrate time. 1536 = OpenAI text-embedding-3-small.
EMBEDDING_DIMENSIONS=1536

# Optional: point at any OpenAI-COMPATIBLE endpoint to run locally/free.
# When set, OPENAI_API_KEY is not required.
#
# Example — fully free local setup with Ollama (https://ollama.com):
#   ollama pull qwen2.5-coder   # a tool-calling capable chat model
#   ollama pull nomic-embed-text
# then set:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5-coder
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
OPENAI_BASE_URL=

# Optional SEPARATE embedding endpoint. Use this to pair a strong chat provider
# that has no embeddings API (e.g. Groq's free tier) with LOCAL Ollama
# embeddings — fully free AND much stronger reasoning:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_your_groq_key
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   OPENAI_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
# When empty, embeddings reuse the chat endpoint above.
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_API_KEY=

# Where connected repositories are cloned for local investigation
WORKSPACE_DIR=./workspace
# Shallow-clone depth (how much git history to fetch)
CLONE_DEPTH=50

# Optional: token used only to clone PRIVATE repos (read-only)
GITHUB_TOKEN=

# Max tool-calling steps per investigation
AGENT_MAX_STEPS=12
# Retries (with backoff) for transient LLM errors like 429 rate limits
LLM_MAX_RETRIES=4

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional Google OAuth ("Sign in with Google"). Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
CLIENT_URL=http://localhost:5173

# ---- Database MCP (read-only introspection target) ----
# Leave blank to introspect the app's own Postgres; or point at any DB.
DB_MCP_URL=

# ---- Logs MCP ----
# Directory of *.log files the logs MCP server searches
LOGS_DIR=./logs

# Enable human-approved write actions (default false = fully read-only)
ENABLE_WRITE_ACTIONS=false

# ---- Client ----
# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:4000
